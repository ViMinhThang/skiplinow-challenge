# Server
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed origins (the Next.js frontend)
CORS_ORIGIN=http://localhost:3000
# When true, SMS/email codes and invite links are logged instead of sent
DEV_MODE=true

# Firebase Admin SDK — one of the two options is required:
# Option A: path to a downloaded service-account JSON file
FIREBASE_SERVICE_ACCOUNT=./firebase-service-account.json
# Option B: point GOOGLE_APPLICATION_CREDENTIALS at the JSON file instead
# GOOGLE_APPLICATION_CREDENTIALS=

# Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+15005550006

# SMTP email (Nodemailer) — e.g. Gmail app password or Resend SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="TaskFlow <no-reply@example.com>"

# Public URL of the frontend, used for invite links in emails
APP_URL=http://localhost:3000

# Seed owner account (created on first boot if none exists)
OWNER_NAME=Alex Owner
OWNER_PHONE=555-0100

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
